include ../head.pug
body(style="background-color: #f9f4ff; font-family: 'Segoe UI', sans-serif;")
  .container.mt-5
    .add-card.shadow-lg.p-4(style="max-width: 600px; margin: 0 auto; border-radius: 20px; background: linear-gradient(135deg, #f0eaff, #ffffff);")
      h2.text-center.text-purple-700.mb-4 #{mode} Flashcard
      
      .mb-3
        label(for="word" class="form-label fw-bold text-purple-700") Word
        input(type="text" class="form-control form-rounded" id="word" name="word" required)

      .mb-3
        label(for="translation" class="form-label fw-bold text-purple-700") Translation
        input(type="text" class="form-control form-rounded" id="translation" name="translation" required)

      .mb-3
        label(for="definition" class="form-label fw-bold text-purple-700") Definition
        textarea(class="form-control form-rounded" id="definition" name="definition")

      .mb-3
        label(for="exampleSentence" class="form-label fw-bold text-purple-700") Example Sentence
        textarea(class="form-control form-rounded" id="exampleSentence" name="exampleSentence")

      .d-flex.justify-content-between.mt-4
        button(type="submit" class="btn btn-primary update-btn" onclick="submitForm()") #{mode === 'Update' ? 'Update' : 'Add'}
        button(type="button" class="btn btn-secondary back-btn" onclick="window.location.href='/'") Back to list
        div(id="error-word")

  script.
    const mode = "#{mode}";
    const flashcardData = !{JSON.stringify(flashcardData || {})};
    const existingFlashcard = mode === "Update" ? flashcardData : null;

    if (existingFlashcard) {
      document.getElementById('word').value = existingFlashcard.word || '';
      document.getElementById('translation').value = existingFlashcard.translation || '';
      document.getElementById('definition').value = existingFlashcard.definition || '';
      document.getElementById('exampleSentence').value = existingFlashcard.exampleSentence || '';
    }

    function clearErrors() {
      document.querySelectorAll('.error-message').forEach(el => el.remove());
    }

    function showValidationError(field, message) {
      const input = document.getElementById(field);
      if (input) {
        const error = document.createElement('div');
        error.className = 'error-message text-danger mt-1';
        error.textContent = message;
        input.parentNode.appendChild(error);
      }
    }

    function submitForm() {
      clearErrors();

      const flashcard = {
        word: document.getElementById('word').value,
        translation: document.getElementById('translation').value,
        definition: document.getElementById('definition').value,
        exampleSentence: document.getElementById('exampleSentence').value,
      };

      const url = mode === "Update"
        ? `/api/flashcard/${existingFlashcard.id}`
        : '/api/flashcard';

      const method = mode === "Update" ? 'put' : 'post';

      axios[method](url, flashcard).then(response => {
        alert('Success!');
        location.href = '/';
      })
      .catch(error => {
        if (error.response && error.response.data.errors) {
          error.response.data.errors.forEach(err => {
            showValidationError(err.path, err.msg);
          });
        } else {
          alert(error);
        }
      });
    }
