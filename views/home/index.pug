include ../head.pug
body
  .container
    h1.text-purple Flashcards
    .text-end.mb-4
      a.btn.add-btn(href='/add') Add Flashcard

    .cards-container
      .row#flashcard-grid

    script(src="/js/cards.js")
    
  script.
    document.addEventListener('DOMContentLoaded', function () {
      axios.get('/api/flashcard')
        .then(function (response) {
          const flashcards = response.data;
          const grid = document.getElementById('flashcard-grid');

          flashcards.forEach(f => {
            const { word, translation, definition, exampleSentence } = f.flashcard || {};
            const col = document.createElement('div');
            col.className = 'col-md-4 mb-4';

            const defHtml = definition?.trim()
              ? `<p class="card-text"><strong>Definition:</strong> ${definition}</p>`
              : '';

            const exampleHtml = exampleSentence?.trim()
              ? `<p class="card-text"><strong>Example:</strong> ${exampleSentence}</p>`
              : '';

            col.innerHTML = `
              <div class="card flashcard-card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title text-primary">${word || ''}</h5>
                  <h6 class="card-subtitle mb-2 text-muted">${translation || ''}</h6>
                  ${defHtml}
                  ${exampleHtml}
                  <div class="mt-auto">
                    <button class="btn btn-sm btn-primary me-2" onclick="window.location.href='/update/${f.id}'">Update</button>
                    <button class="btn btn-sm btn-danger" data-id="${f.id}">Delete</button>
                  </div>
                </div>
              </div>
            `;

            grid.appendChild(col);
          });
        })
        .catch(function (error) {
          console.error("Error loading flashcards:", error);
        });

      document.addEventListener('click', function (event) {
        if (event.target && event.target.classList.contains('btn-danger')) {
          const flashcardId = event.target.getAttribute('data-id');
          const confirmed = confirm('Are you sure you want to delete this flashcard?');
          if (!confirmed) return;

          axios.delete(`/api/flashcard/${flashcardId}`)
            .then(function () {
              alert('Deleted successfully');
              location.reload();
            })
            .catch(function (error) {
              alert('Error deleting flashcard: ' + error);
            });
        }
      });
    });
